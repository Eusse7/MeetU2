# Copiar como .env y ajustar. Nunca se versiona.
DJANGO_SECRET_KEY=cambiar-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Factory de notificaciones: consola | email | push
CANAL_NOTIFICACION=consola

# Factory de pasarela de pago (la lee el microservicio Flask): fake | wompi
PASARELA_PAGO=fake

# Reglas de negocio
COMISION_PLATAFORMA=0.10
MINUTOS_EXPIRACION_RESERVA=30

# Strangler Pattern: microservicio de pagos (Flask)
# Vacio = modo legado (Django confirma con referencia opaca).
PAGOS_SERVICE_URL=
PAGOS_V2_HABILITADO=False

# docker-compose (PostgreSQL). Si POSTGRES_HOST esta vacio se usa SQLite.
POSTGRES_HOST=
POSTGRES_USER=meetu2
POSTGRES_PASSWORD=meetu2_dev
